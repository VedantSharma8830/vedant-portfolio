# Copy this file to .env (npm start does it for you the first time).
# Never commit the real .env file.

# Port the server listens on
PORT=3000

# Password for the admin inbox at /admin. Change this before deploying!
ADMIN_PASSWORD=change-this-password

# Random string used to sign the admin login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed if the frontend is hosted somewhere else (e.g. GitHub Pages)
# and calls this backend. Comma-separated list of allowed origins.
CORS_ORIGIN=

# Max contact form messages per visitor every 10 minutes
CONTACT_RATE_LIMIT=5
